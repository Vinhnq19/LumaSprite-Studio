{
  "name": "lumasprite-studio",
  "version": "0.1.0",
  "description": "Local pixel editor, animation timeline, tilemap and production workspace for game assets.",
  "type": "module",
  "bin": {
    "lumasprite": "./bin/lumasprite.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "scripts/build.js",
    "scripts/launch-studio.js",
    "scripts/mock-external-engine.mjs",
    "start-studio.bat",
    "ARCHITECTURE.md",
    "DEVELOPMENT.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/brand/lumasprite.png",
    "docs/STUDIO.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js",
    "test": "node --experimental-strip-types --test --test-concurrency=4 --disable-warning=ExperimentalWarning \"test/**/!(quality-static-source).test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "studio": "node bin/lumasprite.js studio",
    "studio:dev": "vite studio --host 127.0.0.1",
    "test:studio-ui": "playwright test --config studio/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0",
    "vite": "^6.4.4"
  },
  "keywords": [
    "pixel-art",
    "sprites",
    "gamedev",
    "sprite-sheet",
    "tilemap"
  ]
}
